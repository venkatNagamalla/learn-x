# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database and cache
MONGO_URI=mongodb://localhost:27017/lms
REDIS_URL=redis://localhost:6379

# Authentication - replace with secure secrets
JWT_ACCESS_SECRET=example_access_secret_change_me
JWT_REFRESH_SECRET=example_refresh_secret_change_me

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=example_aws_access_key
AWS_SECRET_ACCESS_KEY=example_aws_secret_key

# S3
AWS_S3_RAW_BUCKET=example-lms-raw-bucket
AWS_S3_PROCESSED_BUCKET=example-lms-processed-bucket

# CloudFront
CLOUDFRONT_DOMAIN=example.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=EXAMPLE_KEY_PAIR_ID
CLOUDFRONT_PRIVATE_KEY_PATH=./keys/private_key.pem

# Payment - PayU
PAYU_KEY=example_payu_key
PAYU_SALT=example_payu_salt
PAYU_BASE_URL=https://test.payu.in
PAYU_WEBHOOK_SECRET=example_payu_webhook_secret

# Payment - Razorpay
RAZORPAY_KEY_ID=rzp_test_example
RAZORPAY_KEY_SECRET=example_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=example_razorpay_webhook_secret

# Platform fees
PLATFORM_FEE_PERCENT=10

# LiveKit
LIVEKIT_URL=wss://example.livekit.cloud
LIVEKIT_API_KEY=example_livekit_api_key
LIVEKIT_API_SECRET=example_livekit_api_secret

# Anthropic
ANTHROPIC_API_KEY=example_anthropic_api_key
